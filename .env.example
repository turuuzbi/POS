# ---------------------------------------------------------------------------
# POS environment variables. Copy to `.env` for local development.
# On Vercel, set these in Project Settings → Environment Variables.
# ---------------------------------------------------------------------------

# PostgreSQL connection string. On Neon use the *pooled* connection string
# (host contains "-pooler") with ?sslmode=require.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pos_dev"

# Direct (non-pooled) connection used only by Prisma Migrate. On Neon this is
# the host WITHOUT "-pooler". Leave unset locally (falls back to DATABASE_URL).
# Vercel's Neon integration provides it as DATABASE_URL_UNPOOLED, which is
# also picked up automatically.
# DIRECT_DATABASE_URL=""

# If a Vercel storage integration injected prefixed variables
# (e.g. STRG_DATABASE_URL), name the prefix here.
# DATABASE_ENV_PREFIX="STRG_"

# Auth.js secret used to sign/encrypt session JWTs and approval tokens.
# Generate with: openssl rand -base64 32   (rotating it signs everyone out)
AUTH_SECRET=""

# Pepper for PIN lookup hashes (HMAC-SHA256). Generate like AUTH_SECRET.
# MUST stay stable: changing it invalidates every staff PIN.
PIN_PEPPER=""

# Pepper for gift-card code hashes (HMAC-SHA256). Generate like AUTH_SECRET.
# MUST stay stable: changing it makes every issued gift card unreadable.
GIFT_CARD_PEPPER=""

# Required when not running on Vercel (e.g. `next start` locally / in CI).
AUTH_TRUST_HOST=true

# Optional: seed credentials for development (defaults are printed by the seed).
# SEED_OWNER_PASSWORD=""

# Optional: Cloudflare R2 for product images. When all five are set, images go to the
# bucket (which must be public via a custom domain or r2.dev); otherwise they are
# written to .data/uploads on local disk (served behind sign-in).
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET=""
# R2_PUBLIC_URL="https://images.example.com"

# !!! STAGING / E2E ONLY !!!  NEVER set this in real production.
# Production builds refuse the mock QPay and mock eBarimt providers (checkout,
# payments and fiscal receipts fail with a configuration error). Setting 1 lets
# a production build use them: no money is received and nothing is filed with
# the tax authority. Our staging deploy and the Playwright production-build
# webServer set it.
# ALLOW_MOCK_PROVIDERS=1
# Mock QPay only (honoured only when mocks are allowed): auto-pay invoices after N
# seconds, or "never". Works across serverless instances, unlike the mock-pay route.
# MOCK_QPAY_AUTOPAY_SECONDS=3

# Shared secret the QPay callback must present (header "x-webhook-secret" or
# "Authorization: Bearer <secret>", or ?token=<secret> in the callback URL).
# Unset = the webhook rejects every call. Generate like AUTH_SECRET.
# QPAY_WEBHOOK_SECRET=""
